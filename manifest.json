{
  "manifest_version": 3,
  "name": "Open Collections",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "description": "把网页与摘录收进分组：侧边栏、搜索、批量打开、备份导入导出，可选 WebDAV 云同步与 AI 整理。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "favicon",
    "alarms"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open Collections",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "management.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "add-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "将当前页面加入当前分组"
    },
    "save-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "将当前页面选中文字存为摘录卡片"
    },
    "toggle-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "打开/关闭 Open Collections 侧边栏"
    }
  }
}
