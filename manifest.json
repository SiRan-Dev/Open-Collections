{
  "manifest_version": 3,
  "name": "Open Pocket",
  "version": "0.1.0",
  "description": "Open Pocket — 本地收藏夹。用侧边栏与独立窗口管理网页集锦：分组、摘录、搜索、批量打开、导入导出与 WebDAV 同步。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "favicon",
    "alarms"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open Pocket",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "management.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "add-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "将当前页面加入当前分组"
    },
    "save-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "将当前页面选中文字存为摘录卡片"
    },
    "toggle-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "打开/关闭 Open Pocket 侧边栏"
    }
  }
}
